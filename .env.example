# Browser-safe hosted Supabase client configuration.
# Find these in Project Settings > API. Do not paste them into documentation.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback. Prefer VITE_SUPABASE_PUBLISHABLE_KEY for new projects.
# VITE_SUPABASE_ANON_KEY=

# Never add service_role, secret keys, database passwords, or access tokens here.
